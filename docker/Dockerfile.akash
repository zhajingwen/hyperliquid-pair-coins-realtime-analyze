# TimescaleDB for Akash Network
FROM timescale/timescaledb:latest-pg16

LABEL maintainer="crypto-analysis" \
      description="TimescaleDB for Hyperliquid Pair Analysis on Akash" \
      version="1.0"

# 复制初始化脚本
COPY database/init_timescaledb.sql /docker-entrypoint-initdb.d/01-init.sql

# 安装必要工具并创建健康检查脚本
RUN apk add --no-cache postgresql-client bash && \
    echo '#!/bin/bash' > /usr/local/bin/healthcheck.sh && \
    echo 'pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} && \' >> /usr/local/bin/healthcheck.sh && \
    echo 'psql -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} -tAc "SELECT 1 FROM pg_extension WHERE extname='"'"'timescaledb'"'"';" | grep -q 1' >> /usr/local/bin/healthcheck.sh && \
    chmod +x /usr/local/bin/healthcheck.sh

# 环境变量
ENV POSTGRES_DB=crypto_data \
    POSTGRES_USER=postgres \
    TIMESCALEDB_TELEMETRY=off \
    TZ=UTC

EXPOSE 5432

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh || exit 1

