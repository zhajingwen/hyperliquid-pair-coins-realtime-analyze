    if is_dns_error(error):
        logger.error(f"🌐 WebSocket DNS 错误: {error}")
        logger.warning("可能原因：网络断开、DNS 服务器故障、域名配置错误")
    else:
        logger.error(f"WebSocket 错误: {error}")


